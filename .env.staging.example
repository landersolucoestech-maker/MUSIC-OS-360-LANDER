# ─────────────────────────────────────────────────────────────────────────────
# .env.staging.example — TEMPLATE para o ambiente STAGING_DESCARTAVEL
#
# NÃO PREENCHER NESTE ARQUIVO E NÃO COMMITAR SEGREDOS.
# Copie para um arquivo fora do controle de versão (ex.: .env.staging) e preencha
# com os valores do BRANCH/PROJETO Supabase descartável — NUNCA de produção.
#
# IMPORTANTE — os scripts NÃO usam um prefixo único. Cada um lê nomes diferentes.
# Este template lista as variáveis STAGING_* como fonte da verdade e, ao lado de
# cada uma, qual nome canônico você deve exportar na hora de rodar cada script
# (ver docs/runbooks/staging-to-production.md e docs/STAGING_ARCHITECTURE.md).
# ─────────────────────────────────────────────────────────────────────────────

# ── URLs do ambiente ─────────────────────────────────────────────────────────
STAGING_API_URL=https://<STAGING_API_URL>
STAGING_WEB_URL=https://<STAGING_WEB_URL>

# ── Supabase (BRANCH descartável) ────────────────────────────────────────────
STAGING_SUPABASE_URL=https://<STAGING_SUPABASE_URL>
STAGING_SUPABASE_ANON_KEY=# publishable/anon key do branch       (harness lê SUPABASE_ANON_KEY)
STAGING_SUPABASE_SERVICE_ROLE_KEY=<STAGING_SUPABASE_SERVICE_ROLE_KEY>
STAGING_SUPABASE_JWT_SECRET=<STAGING_SUPABASE_JWT_SECRET>

# ── Banco (BRANCH descartável) ───────────────────────────────────────────────
STAGING_DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
STAGING_APP_DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
DB_SSL=true                  # branch Supabase normalmente exige SSL

# ── Tenants de homologação (preencher após semear 3 tenants) ─────────────────
STAGING_TENANT_IDS=# "uuidA,uuidB,uuidC" (provision)
RBAC_HARNESS_TENANT_A=# uuidA (harness)
RBAC_HARNESS_TENANT_B=# uuidB (harness)
RBAC_HARNESS_TENANT_C=# uuidC (harness)

# ── Credenciais dos usuários de homologação (harness password-grant) ─────────
# Senha pode ser única (PROVISION_PASSWORD no provision) e reusada aqui.
RBAC_HARNESS_OWNER_EMAIL=rbac-owner@homolog.local
RBAC_HARNESS_OWNER_PASSWORD=false
RBAC_HARNESS_ADMIN_EMAIL=rbac-admin@homolog.local
RBAC_HARNESS_ADMIN_PASSWORD=false
RBAC_HARNESS_MANAGER_EMAIL=rbac-manager@homolog.local
RBAC_HARNESS_MANAGER_PASSWORD=false
RBAC_HARNESS_EDITOR_EMAIL=rbac-editor@homolog.local
RBAC_HARNESS_EDITOR_PASSWORD=false
RBAC_HARNESS_VIEWER_EMAIL=rbac-viewer@homolog.local
RBAC_HARNESS_VIEWER_PASSWORD=false
# opcionais (preferenciais para cobertura 7 roles):
RBAC_HARNESS_ACCOUNTING_EMAIL=rbac-accounting@homolog.local
RBAC_HARNESS_ACCOUNTING_PASSWORD=false
RBAC_HARNESS_ARTIST_EMAIL=rbac-artist@homolog.local
RBAC_HARNESS_ARTIST_PASSWORD=false

# ── Alvos do harness (opcional; defaults entre parênteses) ───────────────────
RBAC_HARNESS_TARGET_REQUESTS=1000   # (1000)
RBAC_HARNESS_TARGET_ENDPOINTS=10    # (10)
RBAC_HARNESS_TARGET_RESOURCES=5     # (5)
RBAC_HARNESS_TARGET_ROLES=5         # (5)
RBAC_HARNESS_TARGET_TENANTS=3       # (3)

# ── Storage R2 (pode reusar o bucket atual ou um prefixo de staging) ─────────
R2_ACCOUNT_ID=<R2_ACCOUNT_ID>
R2_ACCESS_KEY=<R2_ACCESS_KEY>
R2_SECRET_KEY=<R2_SECRET_KEY>
R2_BUCKET_NAME=<R2_BUCKET_NAME>
R2_PUBLIC_URL=https://<R2_PUBLIC_URL>

# ── Observabilidade ──────────────────────────────────────────────────────────
SENTRY_DSN=<SENTRY_DSN>
PROMETHEUS_URL=# ex.: http://localhost:9090 (stack observability local)
GRAFANA_URL=# ex.: http://localhost:3000

# ── Confirmações operacionais (gates de segurança dos scripts) ───────────────
# PROVISION_CONFIRM=YES        # exigido por provision-staging-rbac-users.ts
# PROVISION_PASSWORD=<senha>   # senha única dos 21 usuários (opcional)
