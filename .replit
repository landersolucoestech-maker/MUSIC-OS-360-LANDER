modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
[agent]
expertMode = true
integrations = ["javascript_database:1.0.0", "javascript_openai_ai_integrations:2.0.0", "github:1.0.0"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "node apps/api/dist/main.js"]
build = ["npm", "run", "build"]
publicDir = "dist"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start API"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/web && node_modules/.bin/vite --host 0.0.0.0 --port 5000"
waitForPort = 5000

[[workflows.workflow]]
name = "Start API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/api && npx ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts"
waitForPort = 3001

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5001
externalPort = 5000

[[ports]]
localPort = 5002
externalPort = 4200

[[ports]]
localPort = 5904
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
VITE_API_URL = "http://localhost:3001/api/v1"
VITE_USE_MOCK = "false"
VITE_MOCK_MODE = "false"
VITE_SENTRY_DSN = ""
VITE_POSTHOG_KEY = ""
VITE_APP_NAME = "MUSIC OS 360"

[userenv.development]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
