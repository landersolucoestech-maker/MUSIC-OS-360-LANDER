{
  "name": "music-os-360-monorepo",
  "description": "MUSIC OS 360 — Enterprise Music Management SaaS",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["apps/api"],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "vite --host 0.0.0.0 --port 5000",
    "dev:api": "turbo run dev --filter=@music-os-360/api",
    "build": "turbo run build",
    "build:web": "vite build",
    "build:api": "turbo run build --filter=@music-os-360/api",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "preview": "vite preview --host 0.0.0.0 --port 5000",
    "test:coverage": "vitest run --coverage",
    "typecheck:web": "tsc --noEmit -p tsconfig.app.json",
    "db:generate": "cd apps/api && npx drizzle-kit generate",
    "db:push": "cd apps/api && npx drizzle-kit push",
    "db:migrate": "cd apps/api && npx drizzle-kit migrate",
    "db:studio": "cd apps/api && npx drizzle-kit studio"
  },
  "dependencies": {
