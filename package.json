{
  "name": "music-os-360-monorepo",
  "description": "MUSIC OS 360 — Enterprise Music Management SaaS",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @music-os-360/api --filter @music-os-360/web dev",
    "dev:api": "corepack pnpm --filter @music-os-360/api dev",
    "dev:web": "corepack pnpm --filter @music-os-360/web dev",
    "build": "corepack pnpm --filter @music-os-360/api build && corepack pnpm --filter @music-os-360/web build",
    "typecheck": "corepack pnpm --filter @music-os-360/api typecheck && corepack pnpm --filter @music-os-360/web typecheck",
    "lint": "eslint .",
    "test": "corepack pnpm --filter @music-os-360/api test && corepack pnpm --filter @music-os-360/web test",
    "test:coverage": "pnpm --filter @music-os-360/web run test -- --coverage",
    "monorepo:dev": "turbo run dev",
    "monorepo:build": "turbo run build",
    "monorepo:typecheck": "turbo run typecheck",
    "monorepo:lint": "turbo run lint",
    "repo:clean:dry": "node scripts/cleanup/local-safe-cleanup.mjs --dry-run",
    "repo:clean": "node scripts/cleanup/local-safe-cleanup.mjs --apply",
    "env:check": "node scripts/env-check.mjs",
    "cleanup:check": "node scripts/cleanup/cleanup-check.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:migrate": "node scripts/release-check.mjs --migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "depcheck": "^1.4.7",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "knip": "^6.24.0",
    "supabase": "^2.100.1",
    "ts-prune": "^0.10.3",
    "turbo": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
