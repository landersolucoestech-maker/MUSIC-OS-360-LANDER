{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://engineering-os/contracts/skill-manifest.schema.json",
  "title": "SkillManifest",
  "description": "Shape of a .claude/skills/*/SKILL.md file's YAML frontmatter. Consumer: .claude/runtime/registry.mjs.",
  "type": "object",
  "required": ["name", "description"],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string", "minLength": 20 }
  }
}
