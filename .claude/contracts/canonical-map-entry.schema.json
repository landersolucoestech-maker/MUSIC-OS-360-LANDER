{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://engineering-os/contracts/canonical-map-entry.schema.json",
  "title": "CanonicalMapEntry",
  "description": "One row of the project's canonical naming map (docs/NAMING_NORMALIZATION_CANONICAL_MAP.md, generated by the canonical-naming skill). One concept = one entry. No agent may invent a canonical name independently of this map.",
  "type": "object",
  "required": ["concept", "application", "displayPtBr", "status"],
  "properties": {
    "concept": { "type": "string" },
    "database": { "type": ["string", "null"] },
    "application": { "type": "string" },
    "api": { "type": ["string", "null"] },
    "eventOrQueue": { "type": ["string", "null"] },
    "displayPtBr": { "type": "string" },
    "legacyAliases": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["proposed", "approved", "migrating", "done"] }
  }
}
