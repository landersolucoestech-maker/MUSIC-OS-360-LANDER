{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@shared-types/*": ["../../packages/shared-types/src/*"],
      "@music-os-360/types": ["../../packages/types/src/index.ts"],
      "@music-os-360/types/*": ["../../packages/types/src/*"],
      "@music-os-360/ai-skills": ["../../packages/ai-skills/src/index.ts"],
      "@music-os-360/ai-skills/*": ["../../packages/ai-skills/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
