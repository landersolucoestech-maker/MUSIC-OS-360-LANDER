{
  "name": "@music-os-360/api",
  "version": "0.0.1",
  "description": "MUSIC OS 360 — NestJS Enterprise API",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:coverage": "jest --config jest.config.ts --coverage",
    "test:ci": "jest --config jest.config.ts --coverage --ci --forceExit --passWithNoTests",
    "test:e2e": "jest --config jest.e2e.config.ts",
    "db:migrate": "ts-node-dev --transpile-only --no-notify scripts/db-ops.ts migrate",
    "db:rollback": "ts-node-dev --transpile-only --no-notify scripts/db-ops.ts rollback",
    "db:seed": "ts-node-dev --transpile-only --no-notify src/database/seeds/index.ts",
    "db:reset": "ts-node-dev --transpile-only --no-notify scripts/db-ops.ts reset",
    "db:check": "ts-node-dev --transpile-only --no-notify scripts/db-ops.ts check",
    "db:generate": "ts-node-dev --transpile-only --no-notify scripts/db-ops.ts generate",
    "db:seed:operational": "ts-node-dev --transpile-only --no-notify scripts/db-ops.ts seed:operational",
    "verify:supabase": "ts-node-dev --transpile-only --no-notify scripts/verify-supabase.ts",
    "verify:rls": "ts-node-dev --transpile-only --no-notify scripts/verify-rls.ts",
    "verify:migrations": "ts-node-dev --transpile-only --no-notify scripts/db-ops.ts check",
    "verify:tenant-isolation": "ts-node-dev --transpile-only --no-notify scripts/verify-tenant-isolation.ts",
    "smoke-test": "ts-node-dev --transpile-only --no-notify scripts/smoke-test.ts",
    "provision": "pnpm run verify:supabase && pnpm run verify:rls && pnpm run verify:tenant-isolation",
    "dump:sql": "ts-node-dev --transpile-only --no-notify scripts/dump-migrations-sql.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@supabase/supabase-js": "^2.105.4",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@bull-board/express": "^7.0.0",
    "@bull-board/nestjs": "^7.0.0",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^5.1.1",
    "@nestjs/typeorm": "^11.0.1",
    "@nestjs/websockets": "^10.4.22",
    "@sentry/node": "^10.53.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/pg": "^8.20.0",
    "bullmq": "^5.76.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "openai": "^6.37.0",
    "pg": "^8.20.0",
    "posthog-node": "^5.34.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "stripe": "^22.1.1",
    "typeorm": "^0.3.29",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.20",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.7",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.5",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
