{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@music-os-360/types --filter=@music-os-360/ai-skills",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/internal/cron/contract-expiry", "schedule": "0 3 * * *" },
    { "path": "/internal/cron/invoice-overdue", "schedule": "0 4 * * *" },
    { "path": "/internal/cron/dunning", "schedule": "0 5 * * *" }
  ]
}
