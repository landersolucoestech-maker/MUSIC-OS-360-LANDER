# ── Ambiente ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── PostgreSQL / Supabase ─────────────────────────────────────────────────────
# Direto (migrations): postgresql://postgres:SENHA@db.REF.supabase.co:5432/postgres
# Pooler (runtime):     postgresql://postgres.REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
DATABASE_DIRECT_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
# Set DB_SSL=false ONLY for local Docker Postgres without TLS (dev/staging).
# Default (unset/true) enables ssl: { rejectUnauthorized: false } for Supabase.
DB_SSL=true

# ── Redis (BullMQ Queues) ─────────────────────────────────────────────────────
# Upstash / local Docker — nunca Railway (proibido neste projeto).
REDIS_QUEUE_URL=redis://<REDIS_HOST>:6379
REDIS_URL=redis://<REDIS_HOST>:6379
REDIS_PASSWORD=<REDIS_PASSWORD>

# RBAC persisted authority remains SHADOW until an evidence-based GO decision.
RBAC_PERSISTED_AUTHORITY=SHADOW
RBAC_DUAL_READ_TELEMETRY=true
RBAC_DISTRIBUTED_CACHE_ENABLED=true
RBAC_AUDIT_MIRROR_ENABLED=true
RBAC_DECISION_RETENTION_DAYS=30
RBAC_DECISION_RETENTION_INTERVAL_HOURS=6

# ── App URLs ──────────────────────────────────────────────────────────────────
# APP_URL: server-side OAuth callback base. Production MUST be HTTPS public URL.
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000

# ── Vercel Cron (obrigatório em produção) ────────────────────────────────────
# Autentica /internal/cron/* — Vercel envia Authorization: Bearer <CRON_SECRET>
# automaticamente quando esta variável está configurada no projeto.
CRON_SECRET=<CRON_SECRET>

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5000

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Supabase Dashboard → Settings → API
SUPABASE_URL=https://<SUPABASE_URL>
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>
AUTH_DISABLED=false

# ── Criptografia AES-256 ──────────────────────────────────────────────────────
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<ENCRYPTION_KEY>
ENCRYPTION_IV_SECRET=<ENCRYPTION_IV_SECRET>

# ── Stripe ────────────────────────────────────────────────────────────────────
# Planos/preços NÃO são definidos por env. Fonte primária = tabela billing_plans
# (gerida pelo Painel Admin). O backend sincroniza cada plano com Stripe
# (Product + Price) e guarda stripe_product_id/stripe_price_id no banco.
STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<STRIPE_WEBHOOK_SECRET>
STRIPE_CONNECT_CLIENT_ID=ca_...

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Cloudflare Dashboard → R2 → Manage R2 API tokens
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY=<R2_ACCESS_KEY>
R2_SECRET_KEY=<R2_SECRET_KEY>
R2_BUCKET_NAME=music-os-360
R2_PUBLIC_URL=https://<R2_PUBLIC_URL>

# ── AI ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=<OPENAI_API_KEY>
ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>
GOOGLE_AI_API_KEY=<GOOGLE_AI_API_KEY>

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=<RESEND_API_KEY>
RESEND_FROM_EMAIL=noreply@musicos360.com.br
# Só tem efeito em NODE_ENV=staging: limita destinatários a estes domínios
# (protege contra envio real durante testes manuais em staging).
STAGING_MAIL_ALLOWLIST_DOMAINS=example.com

# ── Monitoramento ─────────────────────────────────────────────────────────────
SENTRY_DSN=<SENTRY_DSN>
SENTRY_RELEASE=0.0.1
POSTHOG_API_KEY=<POSTHOG_API_KEY>

# ── Integrações de Música ──────────────────────────────────────────────────────
# Deezer usa API pública sem chave — nenhuma variável necessária.
ACRCLOUD_HOST=https://<ACRCLOUD_HOST>
ACRCLOUD_ACCESS_KEY=<ACRCLOUD_ACCESS_KEY>
ACRCLOUD_ACCESS_SECRET=<ACRCLOUD_ACCESS_SECRET>
SPOTIFY_CLIENT_ID=<SPOTIFY_CLIENT_ID>
SPOTIFY_CLIENT_SECRET=<SPOTIFY_CLIENT_SECRET>
SPOTIFY_REDIRECT_URI=https://<APP_URL>/api/v1/integrations/spotify/callback
SPOTIFY_OAUTH_STATE_SECRET=<SPOTIFY_OAUTH_STATE_SECRET>
YOUTUBE_API_KEY=<YOUTUBE_API_KEY>
META_APP_ID=<META_APP_ID>
META_APP_SECRET=<META_APP_SECRET>
META_REDIRECT_URI=https://<APP_URL>/api/v1/integrations/instagram/callback
TIKTOK_CLIENT_KEY=<TIKTOK_CLIENT_KEY>
TIKTOK_CLIENT_SECRET=<TIKTOK_CLIENT_SECRET>
TIKTOK_REDIRECT_URI=https://<APP_URL>/api/v1/integrations/tiktok/callback
SOUNDCLOUD_CLIENT_ID=<SOUNDCLOUD_CLIENT_ID>
SOUNDCLOUD_CLIENT_SECRET=<SOUNDCLOUD_CLIENT_SECRET>
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GOOGLE_ADS_CLIENT_ID=<GOOGLE_ADS_CLIENT_ID>
GOOGLE_ADS_CLIENT_SECRET=<GOOGLE_ADS_CLIENT_SECRET>
GOOGLE_ADS_REDIRECT_URI=https://<APP_URL>/api/v1/integrations/google-ads/callback

# ── Assinatura Digital (Autentique) ───────────────────────────────────────────
AUTENTIQUE_WEBHOOK_SECRET=<AUTENTIQUE_WEBHOOK_SECRET>

# ── DocuSign OAuth ────────────────────────────────────────────────────────────
DOCUSIGN_INTEGRATION_KEY=YOUR_DOCUSIGN_INTEGRATION_KEY
DOCUSIGN_CLIENT_SECRET=<DOCUSIGN_CLIENT_SECRET>
DOCUSIGN_AUTH_BASE_URL=https://<DOCUSIGN_AUTH_BASE_URL>

# ── Seeds ─────────────────────────────────────────────────────────────────────
# UUID do usuário Supabase Auth (Authentication → Users no Dashboard)
SEED_ADMIN_SUB=00000000-0000-0000-0000-000000000000
SEED_ADMIN_EMAIL=admin@example.com
