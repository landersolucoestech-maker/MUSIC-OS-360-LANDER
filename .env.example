# ════════════════════════════════════════════════════════════════════════════════
# MUSIC OS 360 — Environment Variables
# Copie para .env e preencha com seus valores reais.
# NUNCA comite o arquivo .env — está no .gitignore.
# Run: npm run verify:supabase para validar configuração.
# ════════════════════════════════════════════════════════════════════════════════

# ── Ambiente ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── PostgreSQL / Supabase ─────────────────────────────────────────────────────
# Direto (para migrations): postgres://postgres:SENHA@db.REF.supabase.co:5432/postgres
# Pooler (produção):        postgres://postgres.REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# Para migrations (sem pooler): mesmo que DATABASE_URL para projetos simples
DIRECT_DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Supabase Dashboard → Settings → API
SUPABASE_URL=https://<SUPABASE_URL>
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>

# ── Criptografia (OBRIGATÓRIO — 64 hex chars = AES-256) ──────────────────────
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<ENCRYPTION_KEY>
ENCRYPTION_IV_SECRET=<ENCRYPTION_IV_SECRET>

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Redis (opcional — filas BullMQ) ──────────────────────────────────────────
# Sem REDIS_URL: filas desabilitadas, API funciona degradada
# Upstash: rediss://default:TOKEN@ENDPOINT:PORT
REDIS_URL=redis://<REDIS_HOST>:6379

# RBAC observability. Do not set authority to ON before shadow readiness.
RBAC_PERSISTED_AUTHORITY=SHADOW
RBAC_DUAL_READ_TELEMETRY=true
RBAC_DISTRIBUTED_CACHE_ENABLED=true
RBAC_AUDIT_MIRROR_ENABLED=true
RBAC_DECISION_RETENTION_DAYS=30
RBAC_DECISION_RETENTION_INTERVAL_HOURS=6

# ── Stripe Billing ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<STRIPE_WEBHOOK_SECRET>
STRIPE_CONNECT_CLIENT_ID=ca_YOUR_CONNECT_CLIENT_ID

# ── Sentry (opcional — observabilidade) ──────────────────────────────────────
SENTRY_DSN=<SENTRY_DSN>
SENTRY_RELEASE=0.0.1

# ── Cloudflare R2 / Storage ───────────────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
R2_BUCKET_NAME=musicos360
R2_PUBLIC_URL=https://<R2_PUBLIC_URL>

# ── IA Providers ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>
OPENAI_API_KEY=<OPENAI_API_KEY>
GOOGLE_AI_API_KEY=<GOOGLE_AI_API_KEY>

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=<RESEND_API_KEY>
EMAIL_FROM=admin@example.com

# ── Integrações de Música ──────────────────────────────────────────────────────
ACRCLOUD_HOST=https://<ACRCLOUD_HOST>
ACRCLOUD_ACCESS_KEY=<ACRCLOUD_ACCESS_KEY>
ACRCLOUD_SECRET_KEY=<ACRCLOUD_SECRET_KEY>
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=<SPOTIFY_CLIENT_SECRET>
YOUTUBE_API_KEY=<YOUTUBE_API_KEY>
DEEZER_APP_ID=YOUR_DEEZER_APP_ID

# ── PostHog (analytics) ───────────────────────────────────────────────────────
POSTHOG_API_KEY=<POSTHOG_API_KEY>
POSTHOG_HOST=https://<POSTHOG_HOST>

# ── Assinatura Digital (Autentique) ───────────────────────────────────────────
AUTENTIQUE_TOKEN=<AUTENTIQUE_TOKEN>
AUTENTIQUE_API_URL=https://<AUTENTIQUE_API_URL>

# ── DocuSign OAuth ────────────────────────────────────────────────────────────
DOCUSIGN_INTEGRATION_KEY=YOUR_DOCUSIGN_INTEGRATION_KEY
DOCUSIGN_CLIENT_SECRET=<DOCUSIGN_CLIENT_SECRET>
DOCUSIGN_AUTH_BASE_URL=https://<DOCUSIGN_AUTH_BASE_URL>

# ── Seeds ─────────────────────────────────────────────────────────────────────
# UUID do usuário Supabase Auth (Authentication → Users no Dashboard)
SEED_ADMIN_SUB=00000000-0000-0000-0000-000000000000
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin Demo
SEED_ORG_NAME=MUSIC OS 360 Demo
SEED_ORG_SLUG=musicos360-demo

# ── Mock Mode (BLOQUEADO EM PRODUÇÃO) ────────────────────────────────────────
MOCK_MODE=false
USE_MOCK=false
VITE_USE_MOCK=false
VITE_MOCK_MODE=false
AUTH_DISABLED=false

# ── Frontend (Vite — copie para apps/web/.env) ────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://<VITE_SUPABASE_URL>
VITE_SUPABASE_ANON_KEY=<VITE_SUPABASE_ANON_KEY>
VITE_AUTH_DISABLED=false
VITE_POSTHOG_KEY=<VITE_POSTHOG_KEY>
VITE_SENTRY_DSN=<VITE_SENTRY_DSN>
VITE_DOCUSIGN_INTEGRATION_KEY=<VITE_DOCUSIGN_INTEGRATION_KEY>
VITE_DOCUSIGN_AUTH_BASE_URL=https://<VITE_DOCUSIGN_AUTH_BASE_URL>
VITE_STRIPE_CONNECT_CLIENT_ID=<VITE_STRIPE_CONNECT_CLIENT_ID>
