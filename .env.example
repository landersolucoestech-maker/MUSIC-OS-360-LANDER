# LANDER 360 — Environment Variables
# Copy to .env and fill in values.

# ─── Frontend (Vite — must be prefixed VITE_) ─────────────────────────────────

# URL of the NestJS backend (no trailing slash).
# Development: http://localhost:3001
# Production:  https://your-backend.railway.app
VITE_API_URL=http://localhost:3001

# Mock mode (VITE_USE_MOCK is canonical; VITE_MOCK_MODE is kept for back-compat).
# "true"  = use in-memory MOCK_DATA (standalone, no backend needed).
# "false" = use real HTTP calls to VITE_API_URL.
VITE_USE_MOCK=true
VITE_MOCK_MODE=true

# ─── Backend (server-side — never exposed to browser) ────────────────────────

DATABASE_URL=postgresql://user:password@localhost:5432/lander360
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3001
CORS_ORIGIN=http://localhost:5000
