# MUSIC OS 360 — Environment Variables
# Copy to .env and fill in values.
# Em Replit: as variáveis marcadas com [Replit Secret] são injectadas
# automaticamente via Replit Secrets — não precisam de valor aqui.

# ─── Frontend (Vite — prefixo VITE_ obrigatório) ──────────────────────────────

# Supabase (auth principal) [Replit Secrets: VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY]
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=SEU_ANON_KEY_AQUI

# Modo mock: true = standalone MOCK_DATA (sem backend)
#            false = chamadas HTTP reais ao NestJS
# Desenvolvimento standalone (padrão): true
# Desenvolvimento conectado ao backend: false
VITE_USE_MOCK=true
VITE_MOCK_MODE=true

# Observability (opcional)
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=

# ─── Backend (server-side — nunca exposto ao browser) ─────────────────────────

# PostgreSQL — Supabase ou Neon [Replit Secret: DATABASE_URL]
DATABASE_URL=postgresql://user:password@db.SEU_PROJECT_ID.supabase.co:5432/postgres?sslmode=require

# Supabase Auth [Replit Secret: SUPABASE_JWT_SECRET]
SUPABASE_JWT_SECRET=SEU_JWT_SECRET_AQUI
# URL do Supabase também usada pelo backend para JWKS (reutiliza var frontend)
# VITE_SUPABASE_URL já definida acima

# Criptografia AES-256 — gere com: openssl rand -hex 32
ENCRYPTION_KEY=SEU_HEX_64_CHARS_AQUI
ENCRYPTION_IV_SECRET=SEU_IV_SECRET_AQUI

# Redis BullMQ (ioredis — deve ser redis:// ou rediss:// acessível)
# [Replit Secret: REDIS_QUEUE_URL]
# Deixe vazio para desactivar BullMQ (modo standby sem conexão)
REDIS_QUEUE_URL=

# Upstash Redis REST (rate-limit / cache — deve ser https://)
# [Replit Secret: UPSTASH_REST_URL + UPSTASH_REDIS_TOKEN]
UPSTASH_REST_URL=https://SEU-ENDPOINT.upstash.io
UPSTASH_REDIS_TOKEN=SEU_TOKEN_AQUI

# Cloudflare R2 [Replit Secrets: R2_ACCOUNT_ID / R2_ACCESS_KEY / R2_SECRET_KEY]
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=music-os-360
R2_PUBLIC_URL=

# AI (opcional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Email (Resend — opcional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@musicos360.com.br

# Monitoramento (opcional)
SENTRY_DSN=
POSTHOG_API_KEY=

# Stripe (opcional em dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# App URL
APP_URL=http://localhost:5000
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5000
