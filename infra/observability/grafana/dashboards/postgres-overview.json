{
  "title": "MUSIC OS 360 - PostgreSQL",
  "uid": "musicos-postgres",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "type": "stat",
      "title": "Database Up",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "musicos_db_up", "refId": "A" }],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 }
    },
    {
      "type": "table",
      "title": "RBAC Decision Rows",
      "datasource": { "type": "postgres", "uid": "${DS_MUSICOS_POSTGRES}" },
      "targets": [{ "format": "table", "rawSql": "SELECT count(*) AS decisions FROM rbac_decision_logs", "refId": "A" }],
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 }
    }
  ]
}
