# Build output
dist/
build/

# Local scratch/state directories
.local/

# Dependencies
node_modules/

# Monorepo / task runner cache
.turbo/

# Vercel CLI project linkage (project/org IDs, not secrets — still not versioned per Vercel's own convention)
.vercel/

# Local agent/tool state
.claude/
.agents/
.config/

# Environment files and secret backups
.env
.env.*
!.env.example
!.env.*.example
# RBAC-SHADOW-01/DBCTX-01 (Parte 45): this is a placeholder-only template
# (<DB_USER>, <ENCRYPTION_KEY>, ...) documenting required production env vars —
# same category as .env.example above. It was previously gitignored by the
# `.env.*` rule and had NEVER been committed, so nobody provisioning production
# could actually see it or the flags it documents.
!apps/api/.env.production.template
.env.backup*
.env.*.backup
*.env.bak
*.env.backup
*.env.secret
*.env.secrets

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Test / coverage
coverage/
.vitest-cache/

# Database / generated temporary artifacts
*.dump
*.bak
*.tmp
*-temp.sql
*.sqlite
*.sqlite3

# Misc generated
*.local
public/mockServiceWorker.js

# Local Claude Code tooling config (not versioned)
.claude/settings.local.json

# RBAC shadow harness — local ES256 signing key (never commit)
supabase/signing_keys.json

# Local secrets directory — protected today only by a nested .gitignore; belt-and-suspenders at root
.secrets/

# Local artifacts — DB dumps, validation screenshots and harness outputs (never commit)
backups/
apps/api/backups/
.validation-shots/
apps/web/.validation-shots*
apps/api/test/rbac-shadow-harness/out/
